{
  "context_thresholds": {
    "warning": 150000,
    "preventive": 160000,
    "cleanup": 170000,
    "critical": 180000,
    "emergency": 195000,
    "hard_limit": 200000
  },
  "compression_levels": {
    "level_1": {
      "name": "预防性压缩",
      "trigger_ratio": 0.75,
      "compression_ratio": 0.4,
      "description": "保留完整结构，压缩注释和次要内容"
    },
    "level_2": {
      "name": "清理压缩",
      "trigger_ratio": 0.85,
      "compression_ratio": 0.6,
      "description": "提取关键信息，保留主要结构"
    },
    "level_3": {
      "name": "紧急压缩",
      "trigger_ratio": 0.95,
      "compression_ratio": 0.8,
      "description": "仅保留核心配置和必要信息"
    }
  },
  "token_estimation": {
    "base_system_overhead": 20000,
    "safety_margin": 0.2,
    "file_weight": {
      "small_file": 1000,
      "medium_file": 5000,
      "large_file": 20000,
      "xlarge_file": 50000
    },
    "step_weights": {
      "analyze": {
        "base": 40000,
        "multiplier": 1.3
      },
      "plan": {
        "base": 25000,
        "multiplier": 1.1
      },
      "transform": {
        "base": 60000,
        "multiplier": 1.5
      },
      "validate": {
        "base": 35000,
        "multiplier": 1.2
      },
      "deploy": {
        "base": 15000,
        "multiplier": 1.0
      }
    }
  },
  "compression_targets": {
    "code_files": {
      "extensions": [".java", ".py", ".js", ".ts", ".go", ".c", ".cpp", ".cs"],
      "strategies": ["extract_signatures", "keep_structure", "remove_comments"]
    },
    "config_files": {
      "extensions": [".yml", ".yaml", ".json", ".xml", ".properties"],
      "strategies": ["keep_structure", "compress_values"]
    },
    "documentation": {
      "extensions": [".md", ".txt", ".rst", ".adoc"],
      "strategies": ["extract_key_points", "remove_examples"]
    },
    "build_files": {
      "extensions": ["pom.xml", "build.gradle", "package.json", "requirements.txt"],
      "strategies": ["keep_dependencies", "compress_metadata"]
    }
  },
  "monitoring": {
    "check_interval": 30,
    "log_level": "info",
    "enable_real_time": true,
    "cleanup_on_threshold": true,
    "auto_cleanup_ratio": 0.8
  },
  "safety_settings": {
    "protect_critical_files": true,
    "min_backup_tokens": 50000,
    "max_single_file_size": 100000,
    "allow_partial_compression": true
  }
}